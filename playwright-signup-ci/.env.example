# Mailsac (free account: https://mailsac.com/register)
MAILSAC_API_KEY=
# Optional: your private Mailsac domain, e.g. test.example.com or yourteam.msdc.co.
# Defaults to public @mailsac.com inboxes (anyone can read them; use made-up data).
MAILSAC_DOMAIN=

# How the app sends mail. Mailsac Email Capture keeps every message in Mailsac:
SMTP_HOST=capture.mailsac.com
SMTP_PORT=5587
SMTP_SECURE=false
SMTP_USER=your-mailsac-username
SMTP_PASS=         # your Mailsac API key
MAIL_FROM="Example App <no-reply@example.com>"
